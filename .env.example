# Public hostname only, without https:// or a path. Required by compose.https.yaml.
DOMAIN=
# Generate with: openssl rand -hex 32. Use the same token on the computer connector.
BRIDGE_TOKEN=
# Optional JSON array of tokens bound to individual guest connectors.
# Team members are set up with `docker compose exec relay node build/relay.mjs team init --name <名字>`; see DEPLOY.md.
BRIDGE_CONNECTOR_TOKENS=[]
