{
  "name": "codex-mobile-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/build-node.ts",
    "relay": "tsx src/server/main.ts",
    "connector": "tsx src/connector/main.ts",
    "setup": "tsx scripts/setup.ts",
    "probe": "tsx scripts/probe.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && npm test",
    "test:native": "tsx scripts/native-check.ts",
    "test:portable": "tsx scripts/portable-check.ts",
    "package:windows": "npm run build && tsx scripts/package-windows.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
