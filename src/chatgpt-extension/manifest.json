{
  "manifest_version": 3,
  "name": "Mobile Web Browser Bridge",
  "version": "0.2.0",
  "description": "Connect selected ChatGPT and Claude tabs to your own Codex Mobile Web connector.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://claude.ai/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
