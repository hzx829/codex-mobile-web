{
  "manifest_version": 3,
  "name": "Cowork Bridge for Codex Mobile Web",
  "version": "0.3.1",
  "description": "Read Claude Cowork projects and conversations from your Codex Mobile Web.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
